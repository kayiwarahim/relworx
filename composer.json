{
  "name": "kayiwarahim/laravel-relworx",
  "description": "A Laravel package for integrating Relworx mobile money collections, disbursements and account transactions.",
  "type": "library",
  "license": "MIT",
  "require": {
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "php": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "KayiwaRahim\\Relworx\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KayiwaRahim\\Relworx\\RelworxServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.0|^11.0|^12.0",
    "guzzlehttp/psr7": "^2.0"
  },
  "autoload-dev": {
    "psr-4": {
      "KayiwaRahim\\Relworx\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-text"
  }
}
